# ===== ملف إعدادات البيئة =====
# انسخ هذا الملف وسمّيه .env.local
# لا ترفع هذا الملف على GitHub أبداً

# ===== مطلوب (required) =====

# JWT secret — أقل 32 حرف عشوائي
# openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS

# Vercel Blob — يُنشأ من Vercel Dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXX

# Neon PostgreSQL (للـ CRM فقط)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ===== اختياري =====

# R2 public URL لفيديوهات Cloudflare (يُستخدم فقط إذا لم تُفعّل الـ presigned URLs)
R2_PUBLIC_URL=https://pub-0e92b408a981462386b3b62d0c02177d.r2.dev

# ===== R2 Presigned URLs (مطلوب لحماية الفيديوهات بروابط تنتهي صلاحيتها) =====
# 1. من Cloudflare Dashboard → R2 → Manage R2 API Tokens → أنشئ Token بصلاحية Object Read
# 2. حوّل الـ Bucket من Public إلى Private
# 3. أضف المتغيرات التالية:
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>
R2_ACCESS_KEY_ID=<token-access-key-id>
R2_SECRET_ACCESS_KEY=<token-secret>

# سر cron endpoint — مطلوب إذا فعّلت cleanup-subscriptions
# openssl rand -hex 32
CRON_SECRET=CHANGE_THIS_TO_RANDOM_HEX_32

# ===== بيئة التشغيل =====
NODE_ENV=production
